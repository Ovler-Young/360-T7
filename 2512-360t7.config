# ImmortalWrt 25.12: official 360T7 FIT image and upstream mt76/WED defaults.
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_qihoo_360t7=y
CONFIG_IPV6=y
CONFIG_USB_SUPPORT=y
CONFIG_KERNEL_NAMESPACES=y
CONFIG_KERNEL_SECCOMP=y
CONFIG_KERNEL_SECCOMP_FILTER=y
CONFIG_PKG_CC_STACKPROTECTOR_REGULAR=y
CONFIG_KERNEL_CC_STACKPROTECTOR_REGULAR=y
CONFIG_PKG_RELRO_FULL=y

# Select one DHCP, TLS and WPA provider; resolve dependencies with defconfig.
